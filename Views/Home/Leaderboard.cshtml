@model IEnumerable<PROG_POE.Models.User>

@{
    ViewData["Title"] = "Leaderboard";
}

<div class="container">
    <div class="leaderboard">
        <div class="items">
            <h1>Leaderboard</h1>
            <hr />
            <table class="table-style">
                <thead>
                    <tr>
                        <th>
                            Position
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Username)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Level)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (User item in ViewBag.Users) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => i)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Username)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Level)
                        </td>
                    </tr>
                    i++;
            }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-style {
        width: 100%;
        border-collapse: separate;
        background-color: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid black;
        border-spacing: 0;
        margin-bottom: 10px;
    }

    th, td {
        border: 1px solid black;
        padding: 10px;
    }

    tr:hover {
        background-color: #E5FAFE;
    }

    .leaderboard {
        width: 700px;
        height: 100%;
        padding: 10px 25px 10px 25px;
        border: 1px solid black;
        display: flex;
        justify-content: center;
        border-radius: 12px;
        background-color: #E5FAFE;
    }

    .items {
        width: 100%;
        text-align: center;
    }

    .container {
        width: max-content;
        height: max-content;
        display: flex;
        justify-content: center;
    }
</style>
