@model IEnumerable<PROG_POE.Models.Report>

@{
    ViewData["Title"] = "Reports";
}
<div class="container">
    <div class="leaderboard">
        <div class="items">
            <h1>Reports</h1>
            <hr />
            <p>Create a report to earn 50xp.</p>
            <p>
                <a class="btn btn-primary" asp-action="CreateReport">Create New</a>
            </p>
            <hr />
            <div>
                <table class="table-style">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Location)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Category)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            File
                        </th>
                    </tr>
                </thead>
                <tbody>
            @foreach (Report item in ViewBag.Reports) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Location)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Category)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ImagePath)
                        </td>
                    </tr>
            }
                </tbody>
            </table>
            </div>
            
        </div>
    </div>
</div>
<style>
    .table-style {
        width: 100%;
        border-collapse: separate;
        background-color: white;
        border-radius: 12px;
        border: 1px solid black;
        overflow: hidden;
        border-spacing: 0;
        margin-bottom: 10px;
    }

    th, td {
        border: 1px solid black;
        padding: 10px;
    }

    tr:hover {
        background-color: #E5FAFE;
    }

    .leaderboard {
        width: 700px;
        height: 100%;
        padding: 10px 25px 10px 25px;
        border: 1px solid #007bff;
        border-radius: 12px;
        background-color: #e9f7ff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin: 0 auto;
    }

    .items {
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        text-align: center;
    }

    .container {
        width: max-content;
        height: max-content;
        display: flex;
        justify-content: center;
    }
</style>
