@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="leaderboard">
        <div class="items">
            <h1 class="display-4">Welcome</h1>
            <hr class="divider" />
            <p class="lead">Complete tasks to earn experience and level up.</p>
            <p>Every 100xp will earn you a level.</p>
            <hr class="divider" />
            <a class="btn btn-primary" asp-controller="Home" asp-action="CreateReport">Report Issues</a><br />
            <a class="btn btn-primary" asp-controller="Home" asp-action="Events">Local Events and Announcements</a><br />
            <a class="btn btn-primary" asp-controller="Home" asp-action="Status">Service Request Status</a><br />
        </div>
    </div>
</div>

<style>
    .btn-primary {
        width: 300px;
    }

    .divider {
        border-color: #007bff;
    }

    .leaderboard {
        max-width: 700px;
        padding: 150px;
        border: 1px solid #007bff;
        border-radius: 12px;
        background-color: #e9f7ff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin: 0 auto;
    }

    .items {
        text-align: center;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }

    .lead {
        font-size: 1.25rem;
        font-weight: 300;
    }
</style>